[submodule "vendor/AetherOthello"]
	path = vendor/AetherOthello
	url = https://github.com/suulnnka/AetherOthello.git
[submodule "vendor/AetherChess"]
	path = vendor/AetherChess
	url = https://github.com/suulnnka/AetherChess.git
	# 本地调参数据(tuner/data/,gitignore)会让子模块显得 dirty,忽略未跟踪项
	ignore = untracked
[submodule "vendor/AetherXiangqi"]
	path = vendor/AetherXiangqi
	url = https://github.com/suulnnka/AetherXiangqi.git
[submodule "vendor/AetherGo"]
	path = vendor/AetherGo
	url = https://github.com/suulnnka/AetherGo.git
[submodule "vendor/AetherRenju"]
	path = vendor/AetherRenju
	url = https://github.com/suulnnka/AetherRenju.git
[submodule "vendor/Aether3DLib"]
	path = vendor/Aether3DLib
	url = git@github.com:suulnnka/Aether3DLib.git

[submodule "vendor/AetherWebDatabase"]
	path = vendor/AetherWebDatabase
	url = git@github.com:suulnnka/AetherWebDatabase.git
